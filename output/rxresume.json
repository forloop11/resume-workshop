        {
          "id": "95f89029-8af2-5369-ae62-33512e60ccfc",
          "hidden": false,
          "company": "Caterpillar Inc.",
          "position": "Lead Data Scientist",
          "location": "Peoria, IL",
          "period": "Sep 2022 – Jun 2026",
          "dates": {
            "start": "2022-09",
            "end": "2026-06",
            "present": false
