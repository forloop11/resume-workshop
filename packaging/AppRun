#!/bin/sh
# Entry point of the Resume Workshop AppImage: runs the editor with the
# bundled Python. An argument is the resume folder to open; without one the
# editor opens the one it had last, or asks (see editor/project.py).
#
# --install-grammar instead installs the optional grammar checker
# (requirements-grammar.txt) for this user, where the editor looks for it
# (PACKAGES in editor/proofing.py). It is downloaded from PyPI, not carried
# in the AppImage, because of its license.
APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
# For the bundled Python's HTTPS (pip, and the editor's update check).
export SSL_CERT_FILE="$APPDIR/opt/_internal/certs.pem"
if [ "${1:-}" = --install-grammar ]; then
    exec "$APPDIR/opt/python/bin/python3" -s -E -m pip install --upgrade --disable-pip-version-check \
        --target "${XDG_DATA_HOME:-$HOME/.local/share}/resume-workshop/packages" \
        -r "$APPDIR/opt/resume-workshop/requirements-grammar.txt"
fi
if [ -n "${1:-}" ]; then
    export RESUME_WORKSHOP_ROOT="$1"
fi
# -s -E: only the bundled packages, whatever the user's site-packages or
# PYTHONPATH hold.
exec "$APPDIR/opt/python/bin/python3" -s -E "$APPDIR/opt/resume-workshop/editor/main.py"
